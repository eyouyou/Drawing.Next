<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 示例共用的模拟数据源(K 线、正弦波),不引任何 UI 框架:WPF / Avalonia 示例都引用它。
		     WPF 业务示例(Hevo.Drawing.LowCodeDemo)引用它,所以按业务工程的红线编译:
		     .NET 5 SDK 5.0.408 能重编(scripts/check-net5.ps1)、LangVersion 9、不开 ImplicitUsings -->
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>9.0</LangVersion>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- 示例看板蓝图(主图 + 成交量),两个宿主都能直接起 -->
		<EmbeddedResource Include="Assets\kline_dashboard.json" LogicalName="Hevo.Charting.Samples.kline_dashboard.json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Hevo.Charting.Core\Hevo.Charting.Core.csproj" />
		<!-- [PortGroup] 端口组由生成器补 -->
		<ProjectReference Include="..\Hevo.Charting.CodeAnalysis\Hevo.Charting.CodeAnalysis.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Analyzer</OutputItemType>
		</ProjectReference>
	</ItemGroup>
</Project>
