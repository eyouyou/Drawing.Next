<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Avalonia 宿主示例:一张 K 线 + SMA,十字线 / 平移 / 滚轮缩放 -->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Hevo.Charting.Avalonia\Hevo.Charting.Avalonia.csproj" />
		<!-- K 线模拟数据源跟 WPF 示例共用 -->
		<ProjectReference Include="..\Hevo.Charting.Samples\Hevo.Charting.Samples.csproj" />
		<!-- [PortGroup] 端口组由生成器补 -->
		<ProjectReference Include="..\Hevo.Charting.CodeAnalysis\Hevo.Charting.CodeAnalysis.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Analyzer</OutputItemType>
		</ProjectReference>
	</ItemGroup>
</Project>
