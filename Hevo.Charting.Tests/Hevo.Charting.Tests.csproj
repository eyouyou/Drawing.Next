<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10 only — 测试项目不在 .NET 5 兼容硬约束里 (README §2),可以用 xUnit / 任何 net6+ API。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- 分析器单测(HookAnalyzerTests)用 Roslyn 现编一段源码跑 UseMemoPlacementAnalyzer。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hevo.Charting\Hevo.Charting.csproj" />
    <ProjectReference Include="..\Hevo.Charting.PythonNet\Hevo.Charting.PythonNet.csproj" />
    <ProjectReference Include="..\Hevo.Trade.Abstractions\Hevo.Trade.Abstractions.csproj" />
    <ProjectReference Include="..\Hevo.Trade.Mock\Hevo.Trade.Mock.csproj" />
    <!-- 示例共用的模拟数据源:demo 看板蓝图里的 MockKLineDataSource 直接用真的,不再写同字段替身 -->
    <ProjectReference Include="..\Hevo.Charting.Samples\Hevo.Charting.Samples.csproj" />
    <!-- 宿主共存(HostCoexistenceTests):只加载 Avalonia 宿主程序集,不起 Avalonia 平台 -->
    <ProjectReference Include="..\Hevo.Charting.Avalonia\Hevo.Charting.Avalonia.csproj" />
    <!-- 当普通程序集引用(不是挂成分析器),测试里直接实例化分析器。 -->
    <ProjectReference Include="..\Hevo.Charting.CodeAnalysis\Hevo.Charting.CodeAnalysis.csproj" />
    <!-- 文档示例(开发规范 / 15 分钟上手引用的代码)单独成一个工程,按业务侧红线编译(LangVersion 9 + 生成器),
         随测试工程一起编译;测试在 DocSampleTests.cs 里跑它们。 -->
    <ProjectReference Include="DocSamples\Hevo.Charting.DocSamples.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DocSamples\**" />
    <None Remove="DocSamples\**" />
    <EmbeddedResource Remove="DocSamples\**" />
  </ItemGroup>

  <!-- §回测 BacktestEngine + Models 住在 Drawing.LowCodeDemo(WinExe + WPF + Python.NET 重依赖),
       不适合作 ProjectReference 拖进来。引擎本身又是纯 BCL 逻辑,值得单测。
       折中:Compile-link 源文件,各编各的 —— 一份代码两个 assembly。 -->
  <ItemGroup>
    <Compile Include="..\Hevo.Drawing.LowCodeDemo\Backtest\BacktestEngine.cs"
             Link="Backtest\BacktestEngine.cs" />
    <Compile Include="..\Hevo.Drawing.LowCodeDemo\Backtest\BacktestModels.cs"
             Link="Backtest\BacktestModels.cs" />
  </ItemGroup>

</Project>
