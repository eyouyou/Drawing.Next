<Project Sdk="Microsoft.NET.Sdk">

  <!-- 文档里引用的示例代码。按业务侧工程的约束编译(同 Drawing.LowCodeDemo):
       LangVersion 9、不开 ImplicitUsings、Roslyn 生成器 / 分析器照常生效。
       示例能编译 = 文档里的写法在真实业务工程里能编译。由 Charting.Tests 引用并测试。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>Hevo.Charting.DocSamples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseMemo 报错的"改前"写法编译不过(HEVO008),不参与编译;HookAnalyzerTests 读源码验证分析器会报。 -->
    <Compile Remove="UseMemo\*.Before.cs" />
    <None Include="UseMemo\*.Before.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 生成器注册写法同 Drawing.LowCodeDemo(绕 .NET 5 SDK _wpftmp 不继承 Analyzer 类型 ProjectReference 的 bug) -->
    <ProjectReference Include="..\..\Hevo.Charting.CodeAnalysis\Hevo.Charting.CodeAnalysis.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <Analyzer Include="..\..\Hevo.Charting.CodeAnalysis\bin\$(Configuration)\netstandard2.0\Hevo.Charting.CodeAnalysis.dll" />
    <ProjectReference Include="..\..\Hevo.Charting\Hevo.Charting.csproj" />
  </ItemGroup>

</Project>
