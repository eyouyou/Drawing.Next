<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- DrawCmd → SKCanvas 翻译层,Avalonia 宿主用它上屏;不碰 Avalonia 控件,只用 Avalonia.Skia 带来的 SkiaSharp -->
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<!-- 实验性后端:代码留在仓库随测试编译,不进任何打包产物;业务工程不引用 -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- 只给 Avalonia 宿主用:SkiaSharp 不单独钉版本,经 Avalonia.Skia 带进来,版本跟 Avalonia 走 -->
		<PackageReference Include="Avalonia.Skia" Version="12.0.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Hevo.Charting.Core\Hevo.Charting.Core.csproj" />
	</ItemGroup>
</Project>
