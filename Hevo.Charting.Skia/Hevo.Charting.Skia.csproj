<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- DrawCmd → SKCanvas 翻译层,不引 UI 框架:WPF 合成面在 Hevo.Charting.Skia.Wpf,Avalonia 宿主直接用本程序集 -->
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<!-- 实验性后端:代码留在仓库随测试编译,不进任何打包产物;业务工程不引用 -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- 跟 Avalonia.Skia 12.0.4 带进来的 SkiaSharp 同版本:进程里只有一份 SkiaSharp -->
		<PackageReference Include="SkiaSharp" Version="3.119.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Hevo.Charting.Core\Hevo.Charting.Core.csproj" />
	</ItemGroup>
</Project>
