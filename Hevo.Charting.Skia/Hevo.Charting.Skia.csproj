<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<LangVersion>preview</LangVersion>
		<!-- 实验性后端:代码留在仓库随测试编译,不进任何打包产物;业务工程不引用 -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" Version="3.119.4" />
		<PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.4" />
		<!-- SkiaSharp.Views.WPF 已传递引用;显式列出是因为 GPU 面直接用到 GLWpfControlSettings(透明背景) -->
		<PackageReference Include="OpenTK.GLWpfControl" Version="4.2.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Hevo.Charting\Hevo.Charting.csproj" />
	</ItemGroup>
</Project>
