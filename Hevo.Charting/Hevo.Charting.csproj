<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<!-- LangVersion=preview 同时锁定 .NET 5 SDK 5.0.408 (net5 LangVersion=preview 才能解锁 record struct / global using),
		     在 net8 上无副作用 — 详见 Hevo.Charting/README.md §2 .NET 5 兼容红线。 -->
		<LangVersion>preview</LangVersion>

		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>obj\Generated</CompilerGeneratedFilesOutputPath>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Hevo.Charting.Core\Hevo.Charting.Core.csproj" />
		<ProjectReference Include="..\Hevo.Charting.CodeAnalysis\Hevo.Charting.CodeAnalysis.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Analyzer</OutputItemType>
			<PrivateAssets>none</PrivateAssets>
		</ProjectReference>
	</ItemGroup>
</Project>
