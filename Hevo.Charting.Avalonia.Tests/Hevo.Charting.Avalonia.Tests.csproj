<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Avalonia 宿主的无窗口测试(Avalonia.Headless + 真 Skia 渲染)。跟 Hevo.Charting.Tests 分开的原因见
		     Hevo.Charting.Avalonia/README.md「测试」:Headless 平台要整个测试程序集一个 Avalonia 应用 + 专用 xunit v3 运行器,
		     跟 WPF 测试的 STA / Application 夹具放一起互相干扰。两种宿主同进程共存另由 Hevo.Charting.Tests 的 HostCoexistenceTests 覆盖 -->
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<OutputType>Exe</OutputType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<!-- Avalonia.Headless.XUnit 12.0.4 编译在 xunit.v3 3.x 上,xunit 跟着停在 3.x -->
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
		<PackageReference Include="Avalonia.Headless.XUnit" Version="12.0.4" />
		<PackageReference Include="Avalonia.Skia" Version="12.0.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Hevo.Charting.Avalonia\Hevo.Charting.Avalonia.csproj" />
		<!-- 示例看板蓝图 + 模拟数据源(蓝图 JSON 起看板的用例) -->
		<ProjectReference Include="..\Hevo.Charting.Samples\Hevo.Charting.Samples.csproj" />
		<ProjectReference Include="..\Hevo.Charting.CodeAnalysis\Hevo.Charting.CodeAnalysis.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Analyzer</OutputItemType>
		</ProjectReference>
	</ItemGroup>
</Project>
